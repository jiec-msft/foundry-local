{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Foundry Local Java public ASR smoke measurement v2/v3",
  "description": "Actual paced inference evidence, not example output. Cross-field timing, exact fixture membership and architecture agreement are enforced by scorer.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "fixture_set_id", "sdk", "environment", "runtime", "model", "readiness", "resources", "lifecycle", "samples", "batch_samples", "cancellation", "provenance"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [2, 3]},
    "fixture_set_id": {"$ref": "#/$defs/nonempty"},
    "sdk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["git_sha"],
      "properties": {
        "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "metadata_git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["os", "host_arch", "jvm_arch", "native_arch", "jdk_version", "jdk_vendor"],
      "properties": {
        "os": {"enum": ["windows", "linux", "macos"]},
        "host_arch": {"$ref": "#/$defs/arch"},
        "jvm_arch": {"$ref": "#/$defs/arch"},
        "native_arch": {"$ref": "#/$defs/arch"},
        "jdk_version": {"$ref": "#/$defs/nonempty"},
        "jdk_vendor": {"$ref": "#/$defs/nonempty"}
      },
      "allOf": [
        {
          "if": {"properties": {"os": {"const": "macos"}}},
          "then": {
            "properties": {
              "host_arch": {"const": "arm64"},
              "jvm_arch": {"const": "arm64"},
              "native_arch": {"const": "arm64"}
            }
          }
        }
      ]
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "sha256"],
      "properties": {
        "version": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": {"$ref": "#/$defs/nonempty"},
        "version": {"$ref": "#/$defs/nonempty"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "elapsed_ms", "cold_start", "model_load_ms"],
      "properties": {
        "status": {"const": "ready"},
        "elapsed_ms": {"anyOf": [{"$ref": "#/$defs/milliseconds"}, {"$ref": "#/$defs/unknown"}]},
        "model_load_ms": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/milliseconds"}},
        "cold_start": {
          "type": "boolean",
          "description": "Initial model-cache cold state, not JVM reuse. Every CLI operation starts a fresh JVM."
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peak_rss_bytes", "rss_method", "runtime_download_bytes", "model_download_bytes", "runtime_install_bytes", "model_install_bytes", "artifact_download_bytes", "sdk_artifact_bytes"],
      "properties": {
        "peak_rss_bytes": {"anyOf": [{"type": "integer", "minimum": 1}, {"$ref": "#/$defs/unknown"}]},
        "rss_method": {"$ref": "#/$defs/nonempty"},
        "runtime_download_bytes": {"$ref": "#/$defs/observed_bytes"},
        "model_download_bytes": {"$ref": "#/$defs/observed_bytes"},
        "artifact_download_bytes": {"$ref": "#/$defs/observed_bytes"},
        "sdk_artifact_bytes": {"$ref": "#/$defs/bytes"},
        "runtime_install_bytes": {"anyOf": [{"type": "integer", "minimum": 1}, {"$ref": "#/$defs/unknown"}]},
        "model_install_bytes": {"anyOf": [{"type": "integer", "minimum": 1}, {"$ref": "#/$defs/unknown"}]}
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["native_loaded", "cancel_verified", "cleanup_verified"],
      "properties": {
        "native_loaded": {"type": "boolean", "const": true},
        "cancel_verified": {"type": "boolean", "const": true},
        "cleanup_verified": {"type": "boolean", "const": true}
      }
    },
    "samples": {
      "type": "array",
      "minItems": 1,
      "description": "Exactly one entry for every frozen manifest ID; no missing or duplicate utterances.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "hypothesis_raw", "timing"],
        "properties": {
          "id": {"$ref": "#/$defs/nonempty"},
          "hypothesis_raw": {"type": "string"},
          "timing": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "audio_duration_ms", "feed_started_ms", "first_nonempty_ms", "input_closed_ms", "finalized_ms", "inference_wall_ms", "chunk_duration_ms"],
            "properties": {
              "mode": {"enum": ["paced", "batch"]},
              "audio_duration_ms": {"$ref": "#/$defs/positive_ms"},
              "feed_started_ms": {"$ref": "#/$defs/milliseconds"},
              "first_nonempty_ms": {
                "anyOf": [{"$ref": "#/$defs/milliseconds"}, {"type": "null"}],
                "description": "First nonempty hypothesis callback, including final callback if no partials. Null only when no nonempty output was observed."
              },
              "input_closed_ms": {"$ref": "#/$defs/milliseconds"},
              "finalized_ms": {"$ref": "#/$defs/milliseconds"},
              "inference_wall_ms": {
                "type": "number",
                "exclusiveMinimum": 0,
                "description": "finalized_ms - feed_started_ms; includes pacing and excludes readiness."
              },
              "chunk_duration_ms": {"type": "number", "exclusiveMinimum": 0, "maximum": 100}
            }
          }
        }
      }
    },
    "batch_samples": {"$ref": "#/properties/samples"},
    "cancellation": {
      "type": "object", "additionalProperties": false,
      "required": ["verified", "cancellation_requested_ms", "acknowledged_ms", "acknowledgment_latency_ms", "natural_input_closed_ms", "submitted_bytes", "cleanup_verified"],
      "properties": {
        "verified": {"const": true},
        "cancellation_requested_ms": {"$ref": "#/$defs/milliseconds"},
        "acknowledged_ms": {"$ref": "#/$defs/milliseconds"},
        "acknowledgment_latency_ms": {"$ref": "#/$defs/milliseconds"},
        "natural_input_closed_ms": {"type": "null"},
        "submitted_bytes": {"$ref": "#/$defs/bytes"},
        "cleanup_verified": {"const": true}
      }
    },
    "provenance": {
      "type": "object", "additionalProperties": false,
      "required": ["sdk_jar_sha256", "jna_sha256", "native_sha256", "timing_origin", "coverage"],
      "properties": {
        "sdk_jar_sha256": {"$ref": "#/$defs/sha256"},
        "jna_sha256": {"$ref": "#/$defs/sha256"},
        "native_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/sha256"}},
        "timing_origin": {"$ref": "#/$defs/nonempty"},
        "coverage": {"$ref": "#/$defs/nonempty"},
        "model_inventory": {
          "type": "object", "additionalProperties": false,
          "required": ["native_rid", "manifest_sha256", "installed_bytes", "files_sha256"],
          "properties": {
            "native_rid": {"enum": ["win-x64", "win-arm64", "linux-x64", "linux-arm64", "osx-arm64"]},
            "manifest_sha256": {"$ref": "#/$defs/sha256"},
            "installed_bytes": {"type": "integer", "minimum": 1},
            "files_sha256": {
              "type": "object", "additionalProperties": false,
              "required": ["model-target-lock.json", "model-target-lock.schema.json", "scripts/model_lock.py"],
              "properties": {
                "model-target-lock.json": {"$ref": "#/$defs/sha256"},
                "model-target-lock.schema.json": {"$ref": "#/$defs/sha256"},
                "scripts/model_lock.py": {"$ref": "#/$defs/sha256"}
              }
            }
          }
        }
      }
    }
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": 3}}},
    "then": {"properties": {
      "sdk": {"required": ["metadata_git_sha"]},
      "provenance": {"required": ["model_inventory"]}
    }},
    "else": {"properties": {
      "sdk": {"not": {"required": ["metadata_git_sha"]}},
      "provenance": {"not": {"required": ["model_inventory"]}}
    }}
  }],
  "$defs": {
    "nonempty": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "arch": {"enum": ["x64", "arm64"]},
    "milliseconds": {"type": "number", "minimum": 0},
    "positive_ms": {"type": "number", "exclusiveMinimum": 0},
    "bytes": {"type": "integer", "minimum": 0},
    "unknown": {
      "type": "object", "additionalProperties": false,
      "required": ["value", "reason"],
      "properties": {"value": {"type": "null"}, "reason": {"$ref": "#/$defs/nonempty"}}
    },
    "observed_bytes": {"anyOf": [{"$ref": "#/$defs/bytes"}, {"$ref": "#/$defs/unknown"}]}
  }
}
